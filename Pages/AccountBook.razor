@page "/"
@page "/account-book"
@using QOL_Upper_App_v3.Services
@inject IJSRuntime JS
@inject FirebaseService FirebaseService

<PageTitle>家計簿 - QOL爆上げ大作戦</PageTitle>

<div class="app-container">
    <header class="app-header">
        <h1 class="app-title">📖 家計簿</h1>
    </header>

    <div class="main-layout @(showDailyExpenseSection ? "" : "centered")">

        <!-- 左パネル：月間サマリー、カレンダー、固定費・収入の内訳 -->
        <section class="left-panel">

            <!-- 月間サマリーカード -->
            <div class="card monthly-summary-card">
                <h3 class="card-title" style="margin-bottom: 12px;">📊 @currentMonth.ToString("yyyy/MM") の収支合計</h3>

                <div class="summary-grid">
                    <div class="summary-box">
                        <span class="summary-label">今月の収入</span>
                        <span class="summary-val text-success">+¥@CurrentMonthIncome.ToString("N0")</span>
                    </div>
                    <div class="summary-box">
                        <span class="summary-label">今月の総支出</span>
                        <span class="summary-val text-danger">-¥@MonthlyTotalExpense.ToString("N0")</span>
                    </div>
                    <div class="summary-box">
                        <span class="summary-label">収支バランス</span>
                        <span class="summary-val @(MonthlyNetBalance >= 0 ? "text-success" : "text-danger")">
                            @(MonthlyNetBalance >= 0 ? "+" : "")¥@MonthlyNetBalance.ToString("N0")
                        </span>
                    </div>
                </div>
            </div>

            <!-- カレンダーカード -->
            <div class="card calendar-card">
                <div class="calendar-header">
                    <button class="btn-nav" @onclick="PrevMonth">◀ 前月</button>
                    <div class="month-title">@currentMonth.ToString("yyyy年 MM月")</div>
                    <button class="btn-nav" @onclick="NextMonth">次月 ▶</button>
                </div>

                <div class="calendar-grid">
                    <div class="weekday-header sun">日</div>
                    <div class="weekday-header">月</div>
                    <div class="weekday-header">火</div>
                    <div class="weekday-header">水</div>
                    <div class="weekday-header">木</div>
                    <div class="weekday-header">金</div>
                    <div class="weekday-header sat">土</div>

                    @foreach (var day in CalendarDays)
                    {
                        var isSelected = day.Date == selectedDate.Date;
                        var isOtherMonth = day.Month != currentMonth.Month;
                        var isToday = day.Date == DateTime.Today;
                        var isSat = day.DayOfWeek == DayOfWeek.Saturday;
                        var isSun = day.DayOfWeek == DayOfWeek.Sunday;
                        var holidayName = GetHolidayName(day);
                        var isHoliday = !string.IsNullOrEmpty(holidayName);
                        var dayExpense = GetDayExpense(day);

                        <div class="calendar-cell @(isOtherMonth ? "other-month" : "") @(isSelected ? "selected" : "") @(isToday ? "today" : "") @(isSat ? "is-saturday" : "") @(isSun ? "is-sunday" : "") @(isHoliday ? "is-holiday" : "")"
                             @onclick="() => SelectDate(day)">
                            <span class="day-number">@day.Day</span>
                            @if (!string.IsNullOrEmpty(holidayName) && !isOtherMonth)
                            {
                                <span class="holiday-name">@holidayName</span>
                            }
                            @if (dayExpense > 0)
                            {
                                <span class="day-expense">-¥@dayExpense.ToString("N0")</span>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- 今月の内訳（収入・固定費）カード -->
            <div class="card month-setting-card">
                <h3 class="card-title" style="margin-bottom: 12px;">⚙️ @currentMonth.ToString("yyyy/MM") の内訳</h3>

                <div class="month-breakdown-container">

                    <!-- 今月の収入 -->
                    <div class="breakdown-column">
                        <div class="breakdown-header">
                            <div>
                                <span>今月の収入</span>
                                <div class="text-success" style="font-size: 1.05rem;">+¥@CurrentMonthIncome.ToString("N0")</div>
                            </div>
                            <button class="btn-action-small" @onclick="OpenIncomeModal">＋ 収入を入力</button>
                        </div>
                        @if (!CurrentMonthIncomeItems.Any())
                        {
                            <p class="empty-msg">収入の登録はありません</p>
                        }
                        else
                        {
                            <ul class="item-list">
                                @foreach (var item in CurrentMonthIncomeItems)
                                {
                                    <li class="item-row">
                                        <div class="item-info">
                                            <span class="badge badge-income">@item.Category</span>
                                            <span class="item-memo">@(string.IsNullOrEmpty(item.Memo) ? item.Category : item.Memo)</span>
                                        </div>
                                        <div class="item-actions">
                                            <span class="item-amount text-success">+¥@item.Amount.ToString("N0")</span>
                                            <button class="btn-delete" @onclick="() => DeleteIncome(item.Id)">×</button>
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                    </div>

                    <!-- 今月の固定費 -->
                    <div class="breakdown-column">
                        <div class="breakdown-header">
                            <div>
                                <span>今月の固定費</span>
                                <div class="text-danger" style="font-size: 1.05rem;">-¥@CurrentMonthFixedExpense.ToString("N0")</div>
                            </div>
                            <button class="btn-action-small" @onclick="OpenFixedExpenseModal">＋ 固定費を入力</button>
                        </div>
                        @if (!CurrentMonthFixedItems.Any())
                        {
                            <p class="empty-msg">固定費の登録はありません</p>
                        }
                        else
                        {
                            <ul class="item-list">
                                @foreach (var item in CurrentMonthFixedItems)
                                {
                                    <li class="item-row">
                                        <div class="item-info">
                                            <span class="badge badge-fixed">@item.Category</span>
                                            <span class="item-memo">@(string.IsNullOrEmpty(item.Memo) ? item.Category : item.Memo)</span>
                                        </div>
                                        <div class="item-actions">
                                            <span class="item-amount text-danger">-¥@item.Amount.ToString("N0")</span>
                                            <button class="btn-delete" @onclick="() => DeleteExpense(item.Id)">×</button>
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                    </div>

                </div>
            </div>

        </section>

        <!-- 右パネル：選択日の日別支出明細 ＆ 入力フォーム -->
        @if (showDailyExpenseSection)
        {
            <section class="right-panel">
                <div class="card list-card">
                    <div class="selected-day-banner" style="margin-bottom: 12px;">
                        <span class="selected-date-text">
                            📅 @selectedDate.ToString("yyyy/MM/dd(ddd)")
                        </span>
                        <span class="text-danger" style="font-weight: bold;">
                            本日支出: -¥@SelectedDayExpense.ToString("N0")
                        </span>
                    </div>

                    <div class="card-title">
                        <span>📋 本日 (@selectedDate.ToString("MM/dd")) の支出明細</span>
                        <button class="btn-close" title="明細と入力欄を閉じる" @onclick="() => showDailyExpenseSection = false">✕</button>
                    </div>

                    @if (!SelectedDayItems.Any())
                    {
                        <p class="empty-msg">この日の支出はありません。</p>
                    }
                    else
                    {
                        <ul class="item-list">
                            @foreach (var item in SelectedDayItems)
                            {
                                <li class="item-row">
                                    <div class="item-info">
                                        <span class="badge">@item.Category</span>
                                        <span class="item-memo">@(string.IsNullOrEmpty(item.Memo) ? item.Category : item.Memo)</span>
                                    </div>
                                    <div class="item-actions">
                                        <span class="item-amount text-danger">-¥@item.Amount.ToString("N0")</span>
                                        <button class="btn-delete" @onclick="() => DeleteExpense(item.Id)">×</button>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </div>

                <div class="card form-card">
                    <h3 class="card-title">💸 支出を入力</h3>

                    <EditForm Model="newDailyExpenseItem" OnValidSubmit="AddDailyExpense">
                        <div class="vertical-form-grid">
                            <div class="form-group">
                                <label>カテゴリ</label>
                                <select class="custom-input" @bind="newDailyExpenseItem.Category">
                                    @foreach (var cat in dailyCategories)
                                    {
                                        <option value="@cat">@cat</option>
                                    }
                                </select>
                            </div>

                            <div class="form-group">
                                <label>金額 (円)</label>
                                <input type="number" class="custom-input-number" @bind="newDailyExpenseItem.Amount" placeholder="0" min="0" />
                            </div>

                            <div class="form-group">
                                <label>メモ</label>
                                <input type="text" class="custom-input" @bind="newDailyExpenseItem.Memo" placeholder="例: スーパーで買出し" />
                            </div>
                        </div>

                        <button type="submit" class="btn-primary">本日の支出に追加する</button>
                    </EditForm>
                </div>
            </section>
        }
    </div>
</div>

<!-- モーダルダイアログ：収入入力 -->
@if (isIncomeModalOpen)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-card" @onclick:stopPropagation>
            <div class="card-title" style="margin-bottom: 20px;">
                <span>💰 今月の収入を入力</span>
                <button class="btn-close" @onclick="CloseModal">✕</button>
            </div>
            <EditForm Model="newIncomeItem" OnValidSubmit="AddIncome">
                <div class="vertical-form-grid">
                    <div class="form-group">
                        <label>カテゴリ</label>
                        <select class="custom-input" @bind="newIncomeItem.Category">
                            @foreach (var cat in incomeCategories)
                            {
                                <option value="@cat">@cat</option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label>金額 (円)</label>
                        <input type="number" class="custom-input-number" @bind="newIncomeItem.Amount" placeholder="0" min="0" />
                    </div>

                    <div class="form-group">
                        <label>メモ</label>
                        <input type="text" class="custom-input" @bind="newIncomeItem.Memo" placeholder="例: 〇〇月分給与" />
                    </div>
                </div>

                <button type="submit" class="btn-success">今月の収入に追加する</button>
            </EditForm>
        </div>
    </div>
}
<!-- モーダルダイアログ：固定費入力 -->
else if (isFixedExpenseModalOpen)
{
<div class="modal-overlay" @onclick="CloseModal">
    <div class="modal-card" @onclick:stopPropagation>
        <div class="card-title" style="margin-bottom: 20px;">
            <span>💳 今月の固定費を入力</span>
            <button class="btn-close" @onclick="CloseModal">✕</button>
        </div>
        <EditForm Model="newFixedExpenseItem" OnValidSubmit="AddFixedExpense">
            <div class="vertical-form-grid">
                <div class="form-group">
                    <label>カテゴリ</label>
                    <select class="custom-input" @bind="newFixedExpenseItem.Category">
                        @foreach (var cat in fixedCategories)
                        {
                            <option value="@cat">@cat</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label>金額 (円)</label>
                    <input type="number" class="custom-input-number" @bind="newFixedExpenseItem.Amount" placeholder="0" min="0" />
                </div>

                <div class="form-group">
                    <label>メモ</label>
                    <input type="text" class="custom-input" @bind="newFixedExpenseItem.Memo" placeholder="例: 10月分電気代" />
                </div>
            </div>

            <button type="submit" class="btn-fixed">今月の固定費に追加する</button>
        </EditForm>
    </div>
</div>
}

@code {
    // 状態管理用フィールド
    private bool isIncomeModalOpen = false;
    private bool isFixedExpenseModalOpen = false;

    private DateTime currentMonth = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime selectedDate = DateTime.Today;

    private List<ExpenseItem> expenseItems = new();
    private List<IncomeItem> incomeItems = new();

    // デフォルトカテゴリ（Firestoreから取得できない場合のフォールバック値）
    private List<string> dailyCategories = new() { "食費", "日用品", "趣味・娯楽", "交通費", "交際費", "その他" };
    private List<string> fixedCategories = new() { "電気代", "ガス代", "水道代", "クレカ", "家賃", "通信費・サブスク", "その他" };
    private List<string> incomeCategories = new() { "給料", "副収入", "ボーナス", "臨時収入", "その他" };

    private string activeModalMode = "なし";
    private bool showDailyExpenseSection = false;

    // 入力フォームバインディング用モデル
    private ExpenseItem newDailyExpenseItem = new();
    private ExpenseItem newFixedExpenseItem = new();
    private IncomeItem newIncomeItem = new();

    // Firestore保存用データ構造
    public class CategorySettingsData
    {
        public List<string> DailyCategories { get; set; } = new();
        public List<string> FixedCategories { get; set; } = new();
        public List<string> IncomeCategories { get; set; } = new();
    }

    private void OpenIncomeModal()
    {
        isIncomeModalOpen = true;
        isFixedExpenseModalOpen = false;
        StateHasChanged();
    }

    private void OpenFixedExpenseModal()
    {
        isFixedExpenseModalOpen = true;
        isIncomeModalOpen = false;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // 初回読み込み時は必ずモーダルを閉じた状態にセット
            isIncomeModalOpen = false;
            isFixedExpenseModalOpen = false;

            await LoadAccountDataAsync();
            await LoadCategoriesFromFirestoreAsync();
            InitFormCategories();

            StateHasChanged();
        }
    }

    // Firestoreからカテゴリ設定を取得
    private async Task LoadCategoriesFromFirestoreAsync()
    {
        try
        {
            var data = await FirebaseService.GetDataAsync<CategorySettingsData>("settings", "categories");
            if (data != null)
            {
                if (data.DailyCategories?.Count > 0) dailyCategories = data.DailyCategories;
                if (data.FixedCategories?.Count > 0) fixedCategories = data.FixedCategories;
                if (data.IncomeCategories?.Count > 0) incomeCategories = data.IncomeCategories;
            }
        }
        catch { }
    }

    // 入力フォームの初期選択ドロップダウン値をセット
    private void InitFormCategories()
    {
        if (dailyCategories.Any()) newDailyExpenseItem.Category = dailyCategories.First();
        if (fixedCategories.Any()) newFixedExpenseItem.Category = fixedCategories.First();
        if (incomeCategories.Any()) newIncomeItem.Category = incomeCategories.First();
    }

    // カレンダーグリッド（35日分）の計算
    private List<DateTime> CalendarDays
    {
        get
        {
            var days = new List<DateTime>();
            var firstDayOfMonth = new DateTime(currentMonth.Year, currentMonth.Month, 1);
            int startDateOffset = (int)firstDayOfMonth.DayOfWeek;
            var startDate = firstDayOfMonth.AddDays(-startDateOffset);

            for (int i = 0; i < 35; i++)
            {
                days.Add(startDate.AddDays(i));
            }
            return days;
        }
    }

    // フィルタリングおよび集計プロパティ
    private IEnumerable<ExpenseItem> SelectedDayItems =>
        expenseItems.Where(x => !x.IsFixed && x.Date.Date == selectedDate.Date);

    private decimal SelectedDayExpense => SelectedDayItems.Sum(x => x.Amount);

    private IEnumerable<ExpenseItem> CurrentMonthFixedItems =>
        expenseItems.Where(x => x.IsFixed && x.Date.Year == currentMonth.Year && x.Date.Month == currentMonth.Month);

    private decimal CurrentMonthFixedExpense => CurrentMonthFixedItems.Sum(x => x.Amount);

    private decimal CurrentMonthDailyExpense =>
        expenseItems.Where(x => !x.IsFixed && x.Date.Year == currentMonth.Year && x.Date.Month == currentMonth.Month)
                    .Sum(x => x.Amount);

    private decimal MonthlyTotalExpense => CurrentMonthDailyExpense + CurrentMonthFixedExpense;

    private IEnumerable<IncomeItem> CurrentMonthIncomeItems =>
        incomeItems.Where(x => x.Date.Year == currentMonth.Year && x.Date.Month == currentMonth.Month);

    private decimal CurrentMonthIncome => CurrentMonthIncomeItems.Sum(x => x.Amount);

    private decimal MonthlyNetBalance => CurrentMonthIncome - MonthlyTotalExpense;

    private decimal GetDayExpense(DateTime date) =>
        expenseItems.Where(x => !x.IsFixed && x.Date.Date == date.Date).Sum(x => x.Amount);

    // イベントハンドラー
    private void SelectDate(DateTime date)
    {
        selectedDate = date;
        showDailyExpenseSection = true;
    }

    private void PrevMonth() => currentMonth = currentMonth.AddMonths(-1);
    private void NextMonth() => currentMonth = currentMonth.AddMonths(1);

    private async Task AddDailyExpense()
    {
        if (newDailyExpenseItem.Amount <= 0) return;

        expenseItems.Add(new ExpenseItem
        {
            Id = Guid.NewGuid(),
            Date = selectedDate,
            Category = newDailyExpenseItem.Category,
            Amount = newDailyExpenseItem.Amount,
            Memo = newDailyExpenseItem.Memo,
            IsFixed = false
        });

        await SaveAccountDataAsync();
        newDailyExpenseItem = new ExpenseItem { Category = dailyCategories.FirstOrDefault() ?? "食費" };
    }

    private async Task AddFixedExpense()
    {
        if (newFixedExpenseItem.Amount <= 0) return;

        expenseItems.Add(new ExpenseItem
        {
            Id = Guid.NewGuid(),
            Date = currentMonth,
            Category = newFixedExpenseItem.Category,
            Amount = newFixedExpenseItem.Amount,
            Memo = newFixedExpenseItem.Memo,
            IsFixed = true
        });

        await SaveAccountDataAsync();
        newFixedExpenseItem = new ExpenseItem { Category = fixedCategories.FirstOrDefault() ?? "電気代" };

        CloseModal(); // 確実に閉じる
    }

    private async Task DeleteExpense(Guid id)
    {
        expenseItems.RemoveAll(x => x.Id == id);
        await SaveAccountDataAsync();
    }

    private async Task AddIncome()
    {
        if (newIncomeItem.Amount <= 0) return;

        incomeItems.Add(new IncomeItem
        {
            Id = Guid.NewGuid(),
            Date = currentMonth,
            Category = newIncomeItem.Category,
            Amount = newIncomeItem.Amount,
            Memo = newIncomeItem.Memo
        });

        await SaveAccountDataAsync();
        newIncomeItem = new IncomeItem { Category = incomeCategories.FirstOrDefault() ?? "給料" };

        CloseModal(); // 確実に閉じる
    }

    private async Task DeleteIncome(Guid id)
    {
        incomeItems.RemoveAll(x => x.Id == id);
        await SaveAccountDataAsync();
    }

    // --- Firestore とのデータ連携（保存・取得） ---

    private async Task SaveAccountDataAsync()
    {
        await FirebaseService.SaveDataAsync("account_data", "expenses", expenseItems);
        await FirebaseService.SaveDataAsync("account_data", "incomes", incomeItems);
    }

    private async Task LoadAccountDataAsync()
    {
        try
        {
            var loadedExpenses = await FirebaseService.GetDataAsync<List<ExpenseItem>>("account_data", "expenses");
            if (loadedExpenses != null) expenseItems = loadedExpenses;

            var loadedIncomes = await FirebaseService.GetDataAsync<List<IncomeItem>>("account_data", "incomes");
            if (loadedIncomes != null) incomeItems = loadedIncomes;
        }
        catch { }
    }

    // 祝日判定ロジック
    private string GetHolidayName(DateTime date)
    {
        int month = date.Month;
        int day = date.Day;

        if (month == 1 && day == 1) return "元日";
        if (month == 1 && isNthDayOfWeek(date, 2, DayOfWeek.Monday)) return "成人の日";
        if (month == 2 && day == 11) return "建国記念の日";
        if (month == 2 && day == 23) return "天皇誕生日";
        if (month == 3 && day == 20) return "春分の日";
        if (month == 4 && day == 29) return "昭和の日";
        if (month == 5 && day == 3) return "憲法記念日";
        if (month == 5 && day == 4) return "みどりの日";
        if (month == 5 && day == 5) return "こどもの日";
        if (month == 7 && isNthDayOfWeek(date, 3, DayOfWeek.Monday)) return "海の日";
        if (month == 8 && day == 11) return "山の日";
        if (month == 9 && isNthDayOfWeek(date, 3, DayOfWeek.Monday)) return "敬老の日";
        if (month == 9 && day == 23) return "秋分の日";
        if (month == 10 && isNthDayOfWeek(date, 2, DayOfWeek.Monday)) return "スポーツの日";
        if (month == 11 && day == 3) return "文化の日";
        if (month == 11 && day == 23) return "勤労感謝の日";

        return string.Empty;
    }

    private bool isNthDayOfWeek(DateTime date, int nth, DayOfWeek dayOfWeek) =>
        date.DayOfWeek == dayOfWeek && (date.Day - 1) / 7 + 1 == nth;

    // データモデル定義
    public class ExpenseItem
    {
        public Guid Id { get; set; }
        public DateTime Date { get; set; } = DateTime.Today;
        public string Category { get; set; } = "食費";
        public decimal Amount { get; set; }
        public string? Memo { get; set; }
        public bool IsFixed { get; set; } = false;
    }

    public class IncomeItem
    {
        public Guid Id { get; set; }
        public DateTime Date { get; set; } = DateTime.Today;
        public string Category { get; set; } = "給料";
        public decimal Amount { get; set; }
        public string? Memo { get; set; }
    }

    // 1. モーダルを閉じて画面を確実に再描画するメソッドを追加
    private void CloseModal()
    {
        activeModalMode = "なし";
        StateHasChanged(); // ★これによって本番環境でも強制的にUIを再描画させてモーダルを消す！
    }
}